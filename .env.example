# ============================================================================
# OPENSPECTRUM-VN — CẤU HÌNH MÔI TRƯỜNG MẪU (100% KHÔNG PHỤ THUỘC TQ)
# Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# ============================================================================

# --- 1. Cổng dịch vụ ---
API_PORT=4000
WEB_PORT=5173
RESEARCH_ENGINE_URL=http://127.0.0.1:8000

# --- 2. Cơ sở dữ liệu (PostgreSQL + pgvector) ---
# Để trống khi chạy dev nhanh không cần Docker (API sẽ tự dùng kho cục bộ an toàn)
DATABASE_URL=postgresql://openspectrum:openspectrum_dev_pw@localhost:5432/openspectrum_vn

# --- 3. Adapter Mô hình Ngôn ngữ Lớn Mở (Thay thế MiniMax / DeepSeek / appmiaoda) ---
# Chọn: ollama (mặc định, miễn phí, chạy local) | gemini | openai
AI_PROVIDER=ollama

# Cấu hình Ollama Local (Khuyên dùng model mở: gemma3:4b hoặc llama3.2:3b)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# Tùy chọn: Google Gemini API (OpenAI-compatible endpoint hoặc REST)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tùy chọn: OpenAI-compatible API khác
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 4. Giọng nói Tiếng Việt Mở (Thay thế Baidu ASR/TTS & MiniMax TTS) ---
# PhoWhisper (VinAI Research) qua faster-whisper local
PHOWHISPER_MODEL=vinai/PhoWhisper-small
ENABLE_LOCAL_ASR=false

# Piper TTS Tiếng Việt (local ONNX, ví dụ: vi_VN-vais1000-medium.onnx)
PIPER_MODEL_PATH=
ENABLE_LOCAL_TTS=false

# --- 5. Khử định danh Dữ liệu Nghiên cứu (Nghị định 13/2023 & Chuẩn FAIR) ---
DEIDENTIFICATION_SALT=change-this-random-salt-in-production-irb-study

# --- 6. Thẻ hình giao tiếp AAC Mở (ARASAAC — CC BY-NC-SA 4.0) ---
ARASAAC_API_BASE=https://api.arasaac.org/v1
ARASAAC_STATIC_BASE=https://static.arasaac.org/pictograms
